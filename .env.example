# =============================================================================
# OSINT Scanner - API Keys (optioneel)
# =============================================================================
# Kopieer dit bestand naar .env en vul je eigen keys in.
# Zonder keys werkt de tool grotedeels (DuckDuckGo fallback, YouTube scraping).
#
#   cp .env.example .env
#
# =============================================================================

# Brave Search API (gratis: 2000 queries/maand)
# Aanvragen: https://brave.com/search/api/
# Zonder key: DuckDuckGo wordt als fallback gebruikt.
BRAVE_API_KEY=

# Overheid.io API (gratis)
# Aanvragen: https://overheid.io/
# Alleen nodig voor KVK-handelsregister-zoekopdrachten.
OVERHEID_IO_API_KEY=

# YouTube Data API v3 (gratis: 10.000 queries/dag)
# Aanvragen: https://console.cloud.google.com/ > APIs & Services > Credentials
# Zonder key: YouTube-IDs worden via page-scraping opgehaald (minder betrouwbaar).
YOUTUBE_API_KEY=

# =============================================================================
# WAF-tolerantie (harvest_client) — allemaal OPTIONEEL
# =============================================================================

# Jitter: randomized pauzes tussen verzoeken per domein (sec).
JITTER_ENABLED=1
JITTER_MIN=0.3
JITTER_MAX=2.0

# Proxy-rotatie: afwisselende IP's (komma- of newline-gescheiden).
PROXY_ROTATION_ENABLED=0
# PROXY_LIST=http://user:pass@proxy1:8080,http://user:pass@proxy2:8080

# Tor-routing: zet 1 zodra Tor (bv. Tor Browser / daemon) lokaal draait.
TOR_ENABLED=0
TOR_PROXY=socks5h://127.0.0.1:9050
# TOR_STRICT_MODE=1   # weiger als Tor uit staat (voor maximale anonimiteit)

# Playwright-fallback: headless Chromium voor doelen met JS-uitdagingen.
# Vereist: pip install playwright && python -m playwright install chromium
PLAYWRIGHT_FALLBACK_ENABLED=0
PLAYWRIGHT_STEALTH_ENABLED=1
